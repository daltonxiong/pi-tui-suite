{
  "name": "pi-tui-suite",
  "version": "0.1.0",
  "description": "pi 的本地 TUI 套件：消息/工具线框、固定输入框、底部状态栏、顶部 header、账户余额角标，并为手机端窄终端优化布局与性能",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "tui",
    "termux",
    "android"
  ],
  "license": "MIT",
  "author": "daltonxiong",
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./vendor/alps-pi@0.3.3/themes"
    ]
  },
  "files": [
    "extensions",
    "src",
    "vendor",
    "tools",
    "README.md",
    "PATCHES.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE"
  ],
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daltonxiong/pi-tui-suite.git"
  },
  "homepage": "https://github.com/daltonxiong/pi-tui-suite#readme",
  "bugs": {
    "url": "https://github.com/daltonxiong/pi-tui-suite/issues"
  }
}
